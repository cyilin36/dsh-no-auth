{
  "name": "dsh-no-auth",
  "version": "0.4.0",
  "private": true,
  "description": "Serve the DSH Web GUI without the launch token, with a plugin-owned LAN listener, client IP/CIDR whitelist, and Settings-page configuration.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/access.js",
    "lib/patch.js",
    "lib/lan-proxy.js",
    "lib/settings-store.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cyilin36/dsh-no-auth.git"
  }
}
